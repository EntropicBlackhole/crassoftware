---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'tvbox apk installer', url: '/saas/tvbox-apk-installer', isCurrent: true }
];
---

<BaseLayout title="cras software / tvbox apk installer" breadcrumbs={breadcrumbs} rootHref="/saas">
  <section class="hero-section" aria-labelledby="hero-title">
    <h1 id="hero-title" data-i18n="product-title">aprovisionamiento zero-touch para android tv.</h1>
    <p class="hero-subtitle" data-i18n="product-desc">
      un cliente nativo de windows en c++ altamente optimizado de 5mb. despliega apks de forma inalámbrica a cualquier tv box android usando descubrimiento mdns y servicios adb integrados. no se requiere línea de comandos.
    </p>
    
    <div class="cta-container">
      <a href="https://github.com/EntropicBlackhole/saas_downloadables/releases/download/v2.0.5/tvbox_deployer_setup_v2.0.5.exe" class="cta-btn" data-i18n="hero-cta">descargar para windows</a>
      <span class="version-tag" data-i18n="hero-tag">v2.0.5 - estable | 4.98 mb</span>
    </div>
  </section>

  <section class="showcase-preview">
    <a class="ghost-btn" href="/saas/tvbox-apk-installer/demo">
      <h2 data-i18n="demo-tag">> ver demo</h2>
    </a>
    <button class="ghost-btn disabled" aria-disabled="true">
      <h2 data-i18n="video-tag">> ver video</h2>
    </button>
    <div class="demo-not-available" data-i18n="dict-def"><span style="color: var(--accent-base);">video</span> no esta disponible aun</div>
  </section>

  <section class="bento-grid">
    <div class="bento-card bento-wide">
      <h3 data-i18n="bento-1-title"><span class="text-accent">60 veces</span> más productividad</h3>
      <p data-i18n="bento-1-desc">de 5 minutos a solo 15 segundos por apk. instala un lote de 10 apks en 2-3 minutos en lugar de perder una hora. escala tu producción diaria y maximiza la rentabilidad de tu tiempo sin esfuerzo manual</p>
    </div>
    <div class="bento-card">
      <h3 data-i18n="bento-2-title">los apks son tuyos <span class="text-accent">para siempre</span></h3>
      <p data-i18n="bento-2-desc">evita portales de anuncios y bucles de redirección de mediafire. escribe un código corto y nuestro analizador regex personalizado extrae el flujo binario sin procesar directamente a tu disco local.</p>
    </div>
    <div class="bento-card">
      <h3 data-i18n="bento-3-title">instalacion 100% <span class="text-accent">inalambrica</span></h3>
      <p data-i18n="bento-3-desc">nunca ejecutes una versión desactualizada. el cliente consulta de forma segura nuestro oráculo en nodejs y ejecuta un traspaso de proceso silencioso e independiente para actualizar el registro del sistema en segundo plano.</p>
    </div>
  </section>

  <section class="pricing-section" id="pricing">
    <h2 data-i18n="pricing-title">licencias simples y directas</h2>
    <div class="pricing-grid">
      <div class="pricing-card">
        <div class="pricing-tier" data-i18n="pricing-tier-1">standard</div>
        <div class="pricing-price">S/50<span data-i18n="pricing-tier-1-unit"> /mo</span></div>
        <ul class="pricing-features">
          <li data-i18n="feat-1.1">licencia vitalicia para 1 pc</li>
          <li data-i18n="feat-1.2">ideal para tecnicos independientes</li>
          <li data-i18n="feat-1.3">recuperas tu inversion rapidamente</li>
        </ul>
      </div>

      <div class="pricing-card highlight">
        <div class="pricing-tier" data-i18n="pricing-tier-2">oferta</div>
        <div class="pricing-price">S/75<span data-i18n="pricing-tier-2-unit"> /one-time</span></div>
        <ul class="pricing-features">
          <li data-i18n="feat-2.1">licencias vitalicias para 2 pcs</li>
          <li data-i18n="feat-2.2">ideal para tiendas fisicas con dos tecnicos</li>
          <li data-i18n="feat-2.3">ahorras S/25 en tu segunda estacion de trabajo</li>
        </ul>
      </div>
    </div>
    <a href="https://wa.me/51917862194" class="pricing-cta" target="_blank" data-i18n="pricing-btn">contactar ventas</a>
  </section>

  <section class="compatibility-section">
    <h2 data-i18n="table-header">compatibilidad de hardware</h2>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th data-i18n="table-col-1">dispositivo</th>
            <th data-i18n="table-col-2">requisito de sistema</th>
            <th data-i18n="table-col-3">estado</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>walmart watchonn 4k+ streaming box</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td>walmart watchonn 4k streaming box</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td>walmart watchonn fhd streaming box</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td>xiaomi mi box s (3rd gen)</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td>xiaomi mi box s (2nd gen)</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td>xiaomi mi tvstick (fhd & 4k)</td>
            <td data-i18n="table-req">android 11+ (depuración inalámbrica)</td>
            <td><span class="status-badge supported" data-i18n="status-supported">soportado</span></td>
          </tr>
          <tr>
            <td data-i18n="table-generic">tv boxes genéricos (android tv)</td>
            <td data-i18n=""></td>
            <td><span class="status-badge unconfirmed" data-i18n="status-unconfirmed">sin confirmar</span></td>
          </tr>
          <tr>
            <td>google chromecast (w/ google tv)</td>
            <td data-i18n=""></td>
            <td><span class="status-badge unconfirmed" data-i18n="status-unconfirmed">sin confirmar</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    max-width: 1000px;
    margin: 80px auto 150px;
    text-align: center;
    padding: 0 20px;
    max-height: 400px;
    height: 350px;
  }

  .hero-section h1 {
    font-size: 3.5rem;
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 40px;
    max-width: 600px;
    margin-inline: auto;
  }

  .cta-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-btn {
    color: var(--bg-base);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 15px 35px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-block;
    border: 4px solid transparent;
    background:
      linear-gradient(var(--text-main), var(--text-main)) padding-box,
      conic-gradient(var(--text-main) var(--fill-angle), var(--accent-base) 0) border-box;
    transition: transform 0.2s ease, color 0.2s ease, --fill-angle 1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    background: var(--accent-base);
    color: white;
    --fill-angle: 0deg;
  }

  .version-tag {
    display: block;
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    width: 80%;
  }

  .showcase-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 450px;
    width: 100%;
    margin: 25px auto 60px;
    position: relative;
  }

  .ghost-btn {
    border: 1px solid var(--border-dim);
    padding: 12px;
    text-align: center;
    color: var(--text-main);
    text-decoration: none;
    font-family: var(--font-mono);
    transition: all 0.2s ease;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    width: 100%;
  }

  .ghost-btn h2 {
    font-size: 1.2rem;
    font-weight: normal;
  }

  .ghost-btn:hover:not(.disabled) {
    border-color: var(--accent-base);
    color: var(--accent-base);
    background: oklch(from var(--accent-base) l c h / 5%);
  }

  .ghost-btn.disabled {
    border-color: var(--border-dim);
    color: var(--text-muted);
    cursor: not-allowed;
  }

  .demo-not-available {
    position: absolute;
    bottom: -35px;
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    text-transform: lowercase;
    width: max-content;
    pointer-events: none;
  }

  .ghost-btn.disabled:hover + .demo-not-available {
    opacity: 1;
    transform: translateY(0);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto 60px;
    padding: 0 20px;
  }

  .bento-wide {
    grid-column: 1 / -1;
  }

  .bento-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 12px;
    padding: 30px;
    transition: border-color 0.2s;
    font-family: var(--font-mono);
  }

  .bento-card:hover {
    border-color: var(--accent-base);
  }

  .bento-card h3 {
    margin-bottom: 15px;
    font-size: 1.3rem;
  }

  .bento-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .text-accent {
    color: var(--accent-base);
  }

  .pricing-section {
    max-width: 1000px;
    margin: 0 auto 100px;
    padding: 0 20px;
  }

  .pricing-section h2 {
    font-size: 2rem;
    margin-bottom: 40px;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .pricing-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 12px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    font-family: var(--font-mono);
  }

  .pricing-card.highlight {
    border-color: var(--accent-base);
  }

  .pricing-card.highlight::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: var(--accent-base);
  }

  .pricing-tier {
    font-size: 1.1rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 15px;
  }

  .pricing-price {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }

  .pricing-price span {
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .pricing-features {
    list-style: none;
    margin-bottom: 40px;
    flex-grow: 1;
  }

  .pricing-features li {
    margin-bottom: 12px;
    color: var(--text-main);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pricing-features li::before {
    content: "✓";
    color: var(--accent-base);
    font-weight: bold;
  }

  .pricing-cta {
    display: block;
    text-align: center;
    color: var(--bg-base);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 12px;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 1.5rem;
    border: 4px solid transparent;
    background:
      linear-gradient(var(--text-main), var(--text-main)) padding-box,
      conic-gradient(var(--text-main) var(--fill-angle), var(--accent-base) 0) border-box;
    transition: transform 0.2s ease, color 0.2s ease, --fill-angle 2s cubic-bezier(0.25, 1, 0.5, 1);
    font-family: var(--font-mono);
  }

  .pricing-cta:hover {
    transform: translateY(-2px);
    background: var(--accent-base);
    color: white;
    --fill-angle: 0deg;
  }

  .compatibility-section {
    max-width: 1000px;
    margin: 0 auto 100px;
    padding: 0 20px;
  }

  .compatibility-section h2 {
    font-size: 1.5rem;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .table-wrapper {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 12px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-family: var(--font-mono);
  }

  th, td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-dim);
  }

  th {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tr:last-child td {
    border-bottom: none;
  }

  .status-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .supported {
    background-color: oklch(from var(--accent-base) l c h / 10%);
    border: 1px solid oklch(from var(--accent-base) l c h / 25%);
    color: var(--accent-base);
  }

  .unconfirmed {
    background-color: rgba(245, 166, 35, 0.1);
    border: 1px solid rgba(245, 166, 35, 0.25);
    color: #f5a623;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .bento-wide {
      grid-column: auto;
    }
    .hero-section {
      margin-top: 100px;
      margin-bottom: 50px;
    }
  }
</style>